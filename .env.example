# Resend (https://resend.com) API key used by src/app/api/lead/route.ts to
# email lead-form submissions. Create a free account, verify a sending
# domain (or use the resend.dev onboarding sender for testing), then create
# an API key and paste it below as .env.local (never commit that file).
RESEND_API_KEY=

# Optional overrides. LEAD_RECIPIENT_EMAIL is where lead notifications are
# actually delivered — it defaults to phanhuutuan1010@gmail.com and is
# intentionally separate from the publicly displayed contact email
# (baselandquynhon@gmail.com, shown on the Contact page and Footer).
LEAD_RECIPIENT_EMAIL=phanhuutuan1010@gmail.com
LEAD_SENDER_EMAIL="Base Land Quy Nhon <onboarding@resend.dev>"

# The site's real production domain (no trailing slash), used for
# metadata.metadataBase (canonical URLs, Open Graph/Twitter image
# resolution) in src/app/layout.tsx. Defaults to http://localhost:3000 in
# dev; set this once the site has a real domain.
NEXT_PUBLIC_SITE_URL=

# Admin CMS — Postgres connection string (Prisma). Any standard managed
# Postgres works (Neon, Supabase, self-hosted). See prisma/schema.prisma.
DATABASE_URL=
# Optional — direct (non-pooled) URL, only needed if DATABASE_URL is a
# pooled/pgbouncer endpoint (Neon/Supabase). See prisma.config.ts.
DIRECT_URL=

# Admin CMS — Media Library. Create a Blob store in the Vercel dashboard
# (Storage > Create Database > Blob) and copy its Read/Write token here.
# Without this, /admin/media still renders but uploads fail with a clear
# in-app error. See ADMIN_GUIDE.md mục 9.
BLOB_READ_WRITE_TOKEN=

