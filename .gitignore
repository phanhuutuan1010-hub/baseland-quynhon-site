# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets, but .env.example documents which
# vars are needed and has no real values, so it's tracked.
.env*
!.env.example

# vercel
.vercel

# resize-photos.js scratch folders — local photos being prepped for upload,
# never meant to be committed.
/photos-in
/photos-out

# fetch-project-images.js output — third-party images pending manual review.
/images-fetched

# typescript
*.tsbuildinfo
next-env.d.ts
